rules_version = '2';

// Reglas solo para el Firebase Local Emulator Suite (proyecto demo-dccbogota,
// sin backend real). Permisivas a propósito para agilizar el prototipo;
// se endurecen antes de conectar un proyecto de Firebase real (ver
// docs/constitution.md, principio 12).
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if true;
    }
  }
}
